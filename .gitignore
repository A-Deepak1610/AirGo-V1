# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual environments & IDEs
.venv/
.vscode/
.DS_Store

# Databases & Environment
*.db
*.sqlite3
data/airgo.db
.env

# Audit runs & Scraper outputs
runs/
*.html
*.png
test_*.json
scratch/
.skills_*.txt

# Exclude generated JSON dumps, but allow project/client JSON configs & data
*.json
!pyrightconfig.json
# Allow client static assets and source data
!client/src/assets/**
!client/public/**
!client/**/*.png
!client/**/*.jpg
!client/**/*.jpeg
!client/**/*.svg
!client/**/*.json

# Frontend
client/node_modules/
client/dist/

